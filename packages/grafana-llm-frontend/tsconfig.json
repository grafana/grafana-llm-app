  "compilerOptions": {
    "declarationDir": "./dist",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es6",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "rootDirs": ["."]
  },
  "include": ["src/**/*.ts*"]
}
